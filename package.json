{
  "name": "mediapipe-dance-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-assets.mjs",
    "predev": "node scripts/setup-assets.mjs",
    "dev": "vite --host localhost --port 5173 --strictPort",
    "prebuild": "node scripts/setup-assets.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "setup-songs": "python3.13 -m venv tools/songs/.venv && tools/songs/.venv/bin/python -m pip install --requirement tools/songs/requirements.txt",
    "add-song": "tools/songs/.venv/bin/python -I tools/songs/add_song.py"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
